{
  "name": "cliper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "client:dev": "vite",
    "server:dev": "python run_server.py",
    "worker:dev": "python run_worker.py",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "dev:full": "concurrently \"npm run client:dev\" \"npm run server:dev\" \"npm run worker:dev\"",
    "install:python": "pip install -r requirements.txt",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "axios": "^1.12.2",
    "clsx": "^1.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "form-data": "^4.0.4",
    "lru-cache": "^10.0.0",
    "lucide-react": "^0.263.1",
    "node-fetch": "^3.3.2",
    "puppeteer": "^24.22.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^1.14.0",
    "uuid": "^13.0.0",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.30",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vercel/node": "^2.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.2.0",
    "jsdom": "^27.0.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.0.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
