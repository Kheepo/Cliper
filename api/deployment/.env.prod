# Production Environment Configuration
# Video Processing System - Production Deployment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=Virality Clipper API
APP_VERSION=2.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
API_V1_STR=/api/v1
API_V2_STR=/api/v2

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=8000
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_CONNECTIONS=1000
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
TIMEOUT=30
KEEPALIVE=5
PRELOAD_APP=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_SERVER=postgres
POSTGRES_USER=clipper_user
POSTGRES_PASSWORD=clipper_secure_password_2024
POSTGRES_DB=clipper_production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://clipper_user:clipper_secure_password_2024@postgres:5432/clipper_production

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_2024
REDIS_DB=0
REDIS_URL=redis://:redis_secure_password_2024@redis:6379/0

# Redis Connection Pool
REDIS_POOL_SIZE=50
REDIS_MAX_CONNECTIONS=100
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# =============================================================================
# CELERY CONFIGURATION
# =============================================================================
CELERY_BROKER_URL=redis://:redis_secure_password_2024@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redis_secure_password_2024@redis:6379/2
CELERY_TASK_SERIALIZER=msgpack
CELERY_RESULT_SERIALIZER=msgpack
CELERY_ACCEPT_CONTENT=msgpack,json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# Worker Configuration
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_DISABLE_RATE_LIMITS=false
CELERY_WORKER_SEND_TASK_EVENTS=true

# Task Configuration
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true
CELERY_TASK_IGNORE_RESULT=false
CELERY_TASK_STORE_EAGER_RESULT=true
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_REJECT_ON_WORKER_LOST=true

# Result Backend Configuration
CELERY_RESULT_EXPIRES=86400
CELERY_RESULT_PERSISTENT=true
CELERY_RESULT_COMPRESSION=gzip

# Beat Configuration
CELERY_BEAT_SCHEDULE_FILENAME=celerybeat-schedule
CELERY_BEAT_SYNC_EVERY=1

# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================
# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-1106-preview
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3

# AI Processing Configuration
AI_CACHE_TTL=3600
AI_BATCH_SIZE=10
AI_CONCURRENT_REQUESTS=5
AI_RATE_LIMIT_PER_MINUTE=100

# =============================================================================
# VIDEO PROCESSING CONFIGURATION
# =============================================================================
# FFmpeg Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_THREADS=0
FFMPEG_PRESET=medium
FFMPEG_CRF=23
FFMPEG_GPU_ACCELERATION=auto

# Video Processing Limits
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600
MAX_CLIP_DURATION_SECONDS=60
MIN_CLIP_DURATION_SECONDS=5
DEFAULT_CLIP_DURATION_SECONDS=30

# Processing Configuration
VIDEO_CHUNK_SIZE_SECONDS=60
MAX_CONCURRENT_CLIPS=4
PROCESSING_TIMEOUT_SECONDS=600
TEMP_FILE_CLEANUP_HOURS=24

# Quality Settings
VIDEO_QUALITY_PRESET=high
AUDIO_BITRATE=128k
VIDEO_BITRATE=2M
VIDEO_RESOLUTION=1920x1080
VIDEO_FPS=30

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# File Storage
UPLOAD_DIR=/app/uploads
TEMP_DIR=/app/temp
OUTPUT_DIR=/app/output
MAX_UPLOAD_SIZE_MB=500

# Storage Cleanup
CLEANUP_TEMP_FILES=true
TEMP_FILE_MAX_AGE_HOURS=24
OUTPUT_FILE_MAX_AGE_DAYS=7

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Configuration
SECRET_KEY=your_super_secure_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
ALLOWED_HOSTS=["*"]
ALLOWED_ORIGINS=["http://localhost:3000", "https://your-domain.com"]
ALLOWED_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
ALLOWED_HEADERS=["*"]
ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
# Logging Configuration
LOG_FORMAT=json
LOG_FILE=/app/logs/app.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5
LOG_ROTATION=daily

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL_SECONDS=30

# Sentry Configuration (Error Tracking)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Memory Management
MAX_MEMORY_USAGE_PERCENT=80
MEMORY_CHECK_INTERVAL_SECONDS=30
GARBAGE_COLLECTION_THRESHOLD=1000

# CPU Management
MAX_CPU_USAGE_PERCENT=90
CPU_CHECK_INTERVAL_SECONDS=30

# Disk Management
MAX_DISK_USAGE_PERCENT=85
DISK_CHECK_INTERVAL_SECONDS=60

# Connection Limits
MAX_CONNECTIONS=1000
CONNECTION_TIMEOUT_SECONDS=30
KEEP_ALIVE_TIMEOUT_SECONDS=5

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8001
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=10
WEBSOCKET_CLOSE_TIMEOUT=10

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Application Cache
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=1024
CACHE_CLEANUP_INTERVAL_SECONDS=300

# Video Metadata Cache
VIDEO_METADATA_CACHE_TTL=7200
TRANSCRIPTION_CACHE_TTL=86400
AI_ANALYSIS_CACHE_TTL=3600

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================
# Database Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/app/backups

# File Backup
FILE_BACKUP_ENABLED=true
FILE_BACKUP_INTERVAL_HOURS=24
FILE_BACKUP_RETENTION_DAYS=7

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Feature Toggles
ENABLE_GPU_ACCELERATION=true
ENABLE_DISTRIBUTED_PROCESSING=true
ENABLE_AI_ANALYSIS=true
ENABLE_CACHING=true
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_RATE_LIMITING=true
ENABLE_WEBSOCKETS=true

# Experimental Features
ENABLE_EXPERIMENTAL_CODECS=false
ENABLE_ADVANCED_AI_FEATURES=true
ENABLE_REAL_TIME_PROCESSING=false

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================
# Cloud Storage (Optional)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-bucket-name

# CDN Configuration (Optional)
# CDN_URL=https://your-cdn-domain.com
# CDN_ENABLED=false

# Analytics (Optional)
# GOOGLE_ANALYTICS_ID=your_ga_id
# MIXPANEL_TOKEN=your_mixpanel_token

# =============================================================================
# DEVELOPMENT OVERRIDES (Remove in production)
# =============================================================================
# These should be removed or set to false in production
DEVELOPMENT_MODE=false
SKIP_AUTH=false
MOCK_AI_SERVICES=false
DISABLE_RATE_LIMITING=false