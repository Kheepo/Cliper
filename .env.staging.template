# Staging Environment Configuration
# Copy this file to .env.staging and fill in the actual values

# Application Settings
ENVIRONMENT=staging
DEBUG=true
APP_NAME=Cliper API (Staging)
APP_VERSION=1.0.0-staging
APP_URL=https://staging.your-domain.com

# Security (Use different keys from production)
JWT_SECRET_KEY=staging-jwt-secret-key-change-this
ENCRYPTION_KEY=staging-32-char-encryption-key
SECRET_KEY=staging-django-secret-key-if-needed

# Database Configuration (Staging database)
DATABASE_URL=postgresql://staging_user:staging_pass@staging-db:5432/cliper_staging
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=15

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=staging-redis-password
REDIS_MAX_CONNECTIONS=25

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# Supabase Configuration (Staging project)
SUPABASE_URL=https://your-staging-project-id.supabase.co
SUPABASE_ANON_KEY=your-staging-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-supabase-service-role-key

# AWS S3 Configuration (Staging bucket)
AWS_ACCESS_KEY_ID=staging-aws-access-key
AWS_SECRET_ACCESS_KEY=staging-aws-secret-key
AWS_S3_BUCKET=your-staging-s3-bucket
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com

# File Upload Settings
MAX_FILE_SIZE=104857600  # 100MB in bytes
UPLOAD_FOLDER=/app/uploads
TEMP_FOLDER=/app/temp
ALLOWED_EXTENSIONS=mp4,avi,mov,mkv,webm

# Rate Limiting (More relaxed for testing)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URL=redis://redis:6379/1
RATE_LIMIT_DEFAULT=200/hour
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_PROCESSING=10/minute

# Security Headers (Less strict for staging)
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_CONTENT_TYPE_NOSNIFF=true
SECURE_BROWSER_XSS_FILTER=true
SECURE_FRAME_DENY=false

# CORS Settings (More permissive for testing)
CORS_ALLOWED_ORIGINS=https://staging.your-domain.com,http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# Logging Configuration (More verbose)
LOG_LEVEL=DEBUG
LOG_FORMAT=detailed
LOG_FILE=/app/logs/staging.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=3

# Monitoring and Alerting (Reduced frequency)
MONITORING_ENABLED=true
ALERT_EMAIL_ENABLED=false  # Disable email alerts in staging
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=staging-alerts@your-domain.com
ALERT_EMAIL_PASSWORD=staging-app-password
ALERT_EMAIL_FROM=staging-alerts@your-domain.com
ALERT_EMAIL_TO=dev-team@your-domain.com

# Slack Notifications (Optional for staging)
ALERT_SLACK_ENABLED=true
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/STAGING/WEBHOOK
ALERT_SLACK_CHANNEL=#staging-alerts

# Discord Notifications (Optional)
ALERT_DISCORD_ENABLED=false
ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/STAGING/WEBHOOK

# Performance Monitoring (Higher thresholds)
PERFORMACE_MONITORING_ENABLED=true
METRICS_RETENTION_DAYS=7
ALERT_CPU_THRESHOLD=90
ALERT_MEMORY_THRESHOLD=90
ALERT_DISK_THRESHOLD=95
ALERT_RESPONSE_TIME_THRESHOLD=10000  # milliseconds

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=15
HEALTH_CHECK_RETRIES=2

# Backup Configuration (Less frequent)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 4 * * 0  # Weekly on Sunday at 4 AM
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=your-staging-backup-bucket
BACKUP_ENCRYPTION_KEY=staging-backup-encryption-key

# Video Processing (Reduced limits for staging)
VIDEO_PROCESSING_TIMEOUT=1800  # 30 minutes
VIDEO_PROCESSING_MAX_WORKERS=2
VIDEO_PROCESSING_QUEUE_SIZE=50
VIDEO_OUTPUT_FORMATS=mp4
VIDEO_QUALITY_LEVELS=720p

# WebSocket Configuration
WEBSOCKET_MAX_CONNECTIONS=100
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=10

# Cache Configuration
CACHE_TTL=1800  # 30 minutes
CACHE_MAX_SIZE=500
CACHE_ENABLED=true

# API Documentation (Always enabled in staging)
API_DOCS_ENABLED=true
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# Testing and Development Features
ENABLE_TEST_ENDPOINTS=true
ENABLE_DEBUG_TOOLBAR=true
ENABLE_PROFILING=true

# Third-party Integrations (Use test/sandbox keys)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# SENDGRID_API_KEY=SG_test...
# TWILIO_ACCOUNT_SID=AC_test...
# TWILIO_AUTH_TOKEN=test_token