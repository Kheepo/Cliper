# Cliper Staging Environment Configuration
# This file contains staging-specific environment variables
# Used for testing production-like deployments

# Application Configuration
ENVIRONMENT=staging
DEBUG=true
APP_NAME=Cliper Staging
APP_VERSION=1.0.0-staging
APP_URL=https://staging.cliper.example.com
API_URL=https://staging-api.cliper.example.com

# Security Configuration
SECRET_KEY=staging-secret-key-not-for-production
JWT_SECRET_KEY=staging-jwt-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
ALLOWED_ORIGINS=https://staging.cliper.example.com,http://localhost:3000,http://localhost:5173
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cliper_staging
POSTGRES_USER=cliper_staging
POSTGRES_PASSWORD=staging_password_123
DATABASE_URL=postgresql://cliper_staging:staging_password_123@postgres:5432/cliper_staging
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_password
REDIS_DB=0
REDIS_URL=redis://:staging_redis_password@redis:6379/0
REDIS_CACHE_TTL=1800
REDIS_SESSION_TTL=43200

# Celery Configuration
CELERY_BROKER_URL=redis://:staging_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:staging_redis_password@redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true
CELERY_TASK_ROUTES_VIDEO_PROCESSING=video_processing
CELERY_TASK_ROUTES_NOTIFICATIONS=notifications
CELERY_TASK_ROUTES_CLEANUP=cleanup
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_MAX_TASKS_PER_CHILD=500
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_BEAT_SCHEDULE_CLEANUP_TEMP_FILES=0 3 * * *
CELERY_BEAT_SCHEDULE_GENERATE_REPORTS=0 7 * * 1
CELERY_BEAT_SCHEDULE_HEALTH_CHECK=*/10 * * * *

# File Storage Configuration
UPLOAD_DIR=/opt/cliper/uploads
STATIC_DIR=/opt/cliper/static
MEDIA_DIR=/opt/cliper/media
MAX_UPLOAD_SIZE=536870912
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,wmv,flv,webm,mkv
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,bmp,webp
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,aac,ogg,flac

# Video Processing Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
VIDEO_PROCESSING_TIMEOUT=1800
VIDEO_PROCESSING_QUALITY=medium
VIDEO_PROCESSING_FORMATS=mp4,webm
VIDEO_THUMBNAIL_COUNT=3
VIDEO_PREVIEW_DURATION=30
VIDEO_MAX_RESOLUTION=1280x720
VIDEO_COMPRESSION_PRESET=fast
VIDEO_BITRATE_LIMIT=3000k

# AI/ML Configuration
OPENAI_API_KEY=sk-test-openai-key-for-staging
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=30
ANTHROPIC_API_KEY=sk-ant-test-key-for-staging
ANTHROPIC_MODEL=claude-3-haiku-20240307
GOOGLE_API_KEY=test-google-api-key-for-staging
GOOGLE_MODEL=gemini-pro

# Email Configuration
SMTP_SERVER=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=staging_smtp_user
SMTP_PASSWORD=staging_smtp_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=staging@cliper.example.com
EMAIL_FROM_NAME=Cliper Staging
DEPLOY_EMAIL=staging-admin@cliper.example.com

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=staging_grafana_password
ALERTMANAGER_PORT=9093
ALERTMANAGER_WEBHOOK_URL=https://hooks.slack.com/services/staging/webhook

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_FILE=/var/log/cliper/staging.log
LOG_MAX_SIZE=50MB
LOG_BACKUP_COUNT=5
LOG_ROTATION=daily
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=cliper-staging-logs
KIBANA_PORT=5601
LOGSTASH_PORT=5044

# Security Configuration
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=3600
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' 'unsafe-eval'
CSP_STYLE_SRC='self' 'unsafe-inline'
CSP_IMG_SRC='self' data: https:
CSP_FONT_SRC='self' https:
CSP_CONNECT_SRC='self' https: ws: wss:
CSP_MEDIA_SRC='self' https:
CSP_OBJECT_SRC='none'
CSP_BASE_URI='self'
CSP_FORM_ACTION='self'
CSP_FRAME_ANCESTORS='none'

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_REQUESTS_PER_HOUR=2000
RATE_LIMIT_REQUESTS_PER_DAY=20000
RATE_LIMIT_BURST_SIZE=20
RATE_LIMIT_STORAGE=redis
RATE_LIMIT_KEY_FUNC=get_remote_address

# Session Configuration
SESSION_COOKIE_NAME=cliper_staging_session
SESSION_COOKIE_DOMAIN=.staging.cliper.example.com
SESSION_COOKIE_PATH=/
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_PERMANENT=false
SESSION_LIFETIME=86400

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/staging.crt
SSL_KEY_PATH=/etc/ssl/private/staging.key
SSL_CA_PATH=/etc/ssl/certs/ca-certificates.crt
SSL_VERIFY_MODE=CERT_OPTIONAL
SSL_CHECK_HOSTNAME=false
SSL_PROTOCOLS=TLSv1.2,TLSv1.3
SSL_CIPHERS=ECDHE+AESGCM:ECDHE+CHACHA20:DHE+AESGCM:DHE+CHACHA20:!aNULL:!MD5:!DSS

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 4 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_COMPRESSION=gzip
BACKUP_ENCRYPTION=false
BACKUP_ENCRYPTION_KEY=staging-backup-key
BACKUP_STORAGE_TYPE=local
BACKUP_S3_BUCKET=cliper-staging-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=staging-s3-access-key
BACKUP_S3_SECRET_KEY=staging-s3-secret-key
BACKUP_LOCAL_PATH=/opt/cliper/backups

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=15
HEALTH_CHECK_RETRIES=2
HEALTH_CHECK_ENDPOINTS=/health,/health/ready,/health/live

# Performance Configuration
WORKER_PROCESSES=2
WORKER_THREADS=2
WORKER_CONNECTIONS=500
WORKER_TIMEOUT=60
WORKER_KEEPALIVE=2
WORKER_MAX_REQUESTS=500
WORKER_MAX_REQUESTS_JITTER=50
WORKER_PRELOAD_APP=true

# Cache Configuration
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=600
CACHE_KEY_PREFIX=cliper:staging:
CACHE_REDIS_HOST=redis
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=staging_redis_password
CACHE_REDIS_DB=3

# API Configuration
API_RATE_LIMIT=2000/hour
API_PAGINATION_DEFAULT_LIMIT=20
API_PAGINATION_MAX_LIMIT=100
API_TIMEOUT=60
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=2

# Notification Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/staging/webhook
SLACK_CHANNEL=#staging-alerts
SLACK_USERNAME=Cliper Staging Bot
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/staging/webhook
TELEGRAM_BOT_TOKEN=staging-telegram-bot-token
TELEGRAM_CHAT_ID=staging-telegram-chat-id

# External Services Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_staging_stripe_key
STRIPE_SECRET_KEY=sk_test_staging_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_staging_webhook_secret
AWS_ACCESS_KEY_ID=staging-aws-access-key
AWS_SECRET_ACCESS_KEY=staging-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=cliper-staging-storage
GOOGLE_CLOUD_PROJECT_ID=cliper-staging-project
GOOGLE_CLOUD_STORAGE_BUCKET=cliper-staging-storage

# Development Tools (enabled in staging)
DEBUG_TOOLBAR=true
PROFILER_ENABLED=true
SQL_ECHO=false
TESTING=false

# Feature Flags
FEATURE_VIDEO_TRANSCRIPTION=true
FEATURE_AI_SUMMARY=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_TOPIC_EXTRACTION=true
FEATURE_REAL_TIME_PROCESSING=true
FEATURE_BATCH_PROCESSING=true
FEATURE_WEBHOOK_NOTIFICATIONS=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_SLACK_INTEGRATION=true
FEATURE_API_RATE_LIMITING=true
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_EXPORT_FUNCTIONALITY=true

# Timezone Configuration
TIMEZONE=UTC
USE_TZ=true
DATE_FORMAT=%Y-%m-%d
TIME_FORMAT=%H:%M:%S
DATETIME_FORMAT=%Y-%m-%d %H:%M:%S

# Localization Configuration
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr
LOCALE_PATH=/opt/cliper/locale
TRANSLATION_BACKEND=gettext

# Content Security
CONTENT_SCAN_ENABLED=false
CONTENT_SCAN_TIMEOUT=30
CONTENT_SCAN_RETRIES=2
VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_TIMEOUT=60
MALWARE_DETECTION=false
CONTENT_MODERATION=false

# Analytics Configuration
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=google
GOOGLE_ANALYTICS_ID=GA-STAGING-ID
GOOGLE_TAG_MANAGER_ID=GTM-STAGING-ID
MIXPANEL_TOKEN=staging-mixpanel-token
SEGMENT_WRITE_KEY=staging-segment-write-key

# Compliance Configuration
GDPR_COMPLIANCE=false
CCPA_COMPLIANCE=false
DATA_RETENTION_DAYS=30
DATA_ANONYMIZATION=false
PRIVACY_POLICY_URL=https://staging.cliper.example.com/privacy
TERMS_OF_SERVICE_URL=https://staging.cliper.example.com/terms
COOKIE_POLICY_URL=https://staging.cliper.example.com/cookies

# Maintenance Configuration
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Staging environment is under maintenance.
MAINTENANCE_ALLOWED_IPS=127.0.0.1,::1,10.0.0.0/8
MAINTENANCE_BYPASS_KEY=staging-maintenance-bypass-key

# Testing Configuration
TEST_DATABASE_URL=postgresql://cliper_test:test_password@postgres:5432/cliper_test
TEST_REDIS_URL=redis://:staging_redis_password@redis:6379/15
TEST_UPLOAD_DIR=/tmp/cliper_test_uploads
TEST_MEDIA_DIR=/tmp/cliper_test_media
TEST_EMAIL_BACKEND=console
TEST_CELERY_ALWAYS_EAGER=true
TEST_CELERY_EAGER_PROPAGATES=true

# Load Testing Configuration
LOAD_TEST_ENABLED=true
LOAD_TEST_USERS=50
LOAD_TEST_SPAWN_RATE=5
LOAD_TEST_RUN_TIME=300
LOAD_TEST_HOST=https://staging.cliper.example.com

# Mock Services Configuration
MOCK_OPENAI=false
MOCK_ANTHROPIC=false
MOCK_GOOGLE=false
MOCK_STRIPE=true
MOCK_AWS=true
MOCK_EMAIL=true
MOCK_SLACK=true

# Debugging Configuration
DEBUG_SQL=false
DEBUG_REDIS=false
DEBUG_CELERY=false
DEBUG_HTTP=false
DEBUG_WEBSOCKET=false
DEBUG_AI_PROCESSING=true
DEBUG_VIDEO_PROCESSING=true

# Resource Limits (lower for staging)
MAX_CONCURRENT_UPLOADS=5
MAX_CONCURRENT_PROCESSING=3
MAX_QUEUE_SIZE=100
MAX_MEMORY_USAGE=2048
MAX_CPU_USAGE=80
MAX_DISK_USAGE=80

# Staging-specific Features
STAGING_DATA_RESET=true
STAGING_MOCK_DATA=true
STAGING_TEST_USERS=true
STAGING_PERFORMANCE_MONITORING=true
STAGING_ERROR_SIMULATION=false
STAGING_LOAD_SIMULATION=false