{
  "dashboard": {
    "id": null,
    "title": "Video Processing System - Production Dashboard",
    "tags": ["video-processing", "production", "monitoring"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "30s",
    "schemaVersion": 27,
    "version": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(up, instance)",
          "refresh": 1,
          "includeAll": true,
          "allValue": ".*",
          "multi": true
        },
        {
          "name": "job",
          "type": "query",
          "query": "label_values(up, job)",
          "refresh": 1,
          "includeAll": true,
          "allValue": ".*",
          "multi": true
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "System Overview",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
        "collapsed": false
      },
      {
        "id": 2,
        "title": "Service Status",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 1},
        "targets": [
          {
            "expr": "up{job=~\"$job\", instance=~\"$instance\"}",
            "legendFormat": "{{job}} - {{instance}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {"options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}
            ]
          }
        }
      },
      {
        "id": 3,
        "title": "Request Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 9, "x": 6, "y": 1},
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"video-api\"}[5m])",
            "legendFormat": "{{method}} {{status}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "Requests/sec", "min": 0}
        ]
      },
      {
        "id": 4,
        "title": "Error Rate",
        "type": "singlestat",
        "gridPos": {"h": 8, "w": 9, "x": 15, "y": 1},
        "targets": [
          {
            "expr": "(rate(http_requests_total{job=\"video-api\",status=~\"5..\"}[5m]) / rate(http_requests_total{job=\"video-api\"}[5m])) * 100",
            "legendFormat": "Error Rate %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Video Processing Metrics",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
        "collapsed": false
      },
      {
        "id": 6,
        "title": "Active Video Processing Tasks",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
        "targets": [
          {
            "expr": "celery_tasks_active{task=\"process_video_clips_task\"}",
            "legendFormat": "Active Tasks",
            "refId": "A"
          },
          {
            "expr": "celery_queue_length{queue=\"video_processing\"}",
            "legendFormat": "Queue Length",
            "refId": "B"
          }
        ],
        "yAxes": [
          {"label": "Count", "min": 0}
        ]
      },
      {
        "id": 7,
        "title": "Video Processing Success Rate",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 10},
        "targets": [
          {
            "expr": "(rate(celery_task_success_total{task=\"process_video_clips_task\"}[10m]) / (rate(celery_task_success_total{task=\"process_video_clips_task\"}[10m]) + rate(celery_task_failed_total{task=\"process_video_clips_task\"}[10m]))) * 100",
            "legendFormat": "Success Rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 90},
                {"color": "green", "value": 95}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Average Processing Time",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 10},
        "targets": [
          {
            "expr": "avg(celery_task_runtime_seconds{task=\"process_video_clips_task\"})",
            "legendFormat": "Avg Time",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 300},
                {"color": "red", "value": 600}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "System Resources",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
        "collapsed": false
      },
      {
        "id": 10,
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 19},
        "targets": [
          {
            "expr": "100 - (avg by (instance) (irate(node_cpu_seconds_total{mode=\"idle\", instance=~\"$instance\"}[5m])) * 100)",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "Percent", "min": 0, "max": 100}
        ]
      },
      {
        "id": 11,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 19},
        "targets": [
          {
            "expr": "((node_memory_MemTotal_bytes{instance=~\"$instance\"} - node_memory_MemAvailable_bytes{instance=~\"$instance\"}) / node_memory_MemTotal_bytes{instance=~\"$instance\"}) * 100",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "Percent", "min": 0, "max": 100}
        ]
      },
      {
        "id": 12,
        "title": "Disk Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 19},
        "targets": [
          {
            "expr": "((node_filesystem_size_bytes{instance=~\"$instance\", fstype!=\"tmpfs\"} - node_filesystem_free_bytes{instance=~\"$instance\", fstype!=\"tmpfs\"}) / node_filesystem_size_bytes{instance=~\"$instance\", fstype!=\"tmpfs\"}) * 100",
            "legendFormat": "{{instance}} - {{mountpoint}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "Percent", "min": 0, "max": 100}
        ]
      },
      {
        "id": 13,
        "title": "Database & Cache",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27},
        "collapsed": false
      },
      {
        "id": 14,
        "title": "Database Connections",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "pg_stat_database_numbackends",
            "legendFormat": "Active Connections",
            "refId": "A"
          },
          {
            "expr": "pg_settings_max_connections",
            "legendFormat": "Max Connections",
            "refId": "B"
          }
        ],
        "yAxes": [
          {"label": "Connections", "min": 0}
        ]
      },
      {
        "id": 15,
        "title": "Database Query Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 28},
        "targets": [
          {
            "expr": "rate(pg_stat_database_tup_returned[5m])",
            "legendFormat": "Rows Returned/sec",
            "refId": "A"
          },
          {
            "expr": "rate(pg_stat_database_tup_fetched[5m])",
            "legendFormat": "Rows Fetched/sec",
            "refId": "B"
          }
        ],
        "yAxes": [
          {"label": "Rows/sec", "min": 0}
        ]
      },
      {
        "id": 16,
        "title": "Redis Memory Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 28},
        "targets": [
          {
            "expr": "redis_memory_used_bytes",
            "legendFormat": "Used Memory",
            "refId": "A"
          },
          {
            "expr": "redis_memory_max_bytes",
            "legendFormat": "Max Memory",
            "refId": "B"
          }
        ],
        "yAxes": [
          {"label": "Bytes", "min": 0}
        ]
      },
      {
        "id": 17,
        "title": "AI & Processing Services",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 36},
        "collapsed": false
      },
      {
        "id": 18,
        "title": "AI Service Response Time",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 37},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(ai_service_duration_seconds_bucket[5m]))",
            "legendFormat": "50th percentile",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(ai_service_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(ai_service_duration_seconds_bucket[5m]))",
            "legendFormat": "99th percentile",
            "refId": "C"
          }
        ],
        "yAxes": [
          {"label": "Seconds", "min": 0}
        ]
      },
      {
        "id": 19,
        "title": "FFmpeg Process Status",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 37},
        "targets": [
          {
            "expr": "ffmpeg_processes_active",
            "legendFormat": "Active Processes",
            "refId": "A"
          },
          {
            "expr": "rate(ffmpeg_process_success_total[5m])",
            "legendFormat": "Success Rate/sec",
            "refId": "B"
          },
          {
            "expr": "rate(ffmpeg_process_failures_total[5m])",
            "legendFormat": "Failure Rate/sec",
            "refId": "C"
          }
        ],
        "yAxes": [
          {"label": "Count/Rate", "min": 0}
        ]
      },
      {
        "id": 20,
        "title": "WebSocket Connections",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 37},
        "targets": [
          {
            "expr": "websocket_connections_active",
            "legendFormat": "Active Connections",
            "refId": "A"
          },
          {
            "expr": "rate(websocket_connections_total[5m])",
            "legendFormat": "New Connections/sec",
            "refId": "B"
          },
          {
            "expr": "rate(websocket_disconnections_total[5m])",
            "legendFormat": "Disconnections/sec",
            "refId": "C"
          }
        ],
        "yAxes": [
          {"label": "Connections", "min": 0}
        ]
      },
      {
        "id": 21,
        "title": "Performance Metrics",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 45},
        "collapsed": false
      },
      {
        "id": 22,
        "title": "API Response Times",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 46},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"video-api\"}[5m]))",
            "legendFormat": "50th percentile",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"video-api\"}[5m]))",
            "legendFormat": "95th percentile",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"video-api\"}[5m]))",
            "legendFormat": "99th percentile",
            "refId": "C"
          }
        ],
        "yAxes": [
          {"label": "Seconds", "min": 0}
        ]
      },
      {
        "id": 23,
        "title": "Throughput by Endpoint",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 46},
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"video-api\"}[5m])",
            "legendFormat": "{{method}} {{handler}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "Requests/sec", "min": 0}
        ]
      },
      {
        "id": 24,
        "title": "Alerts & Status",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 54},
        "collapsed": false
      },
      {
        "id": 25,
        "title": "Active Alerts",
        "type": "table",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 55},
        "targets": [
          {
            "expr": "ALERTS{alertstate=\"firing\"}",
            "legendFormat": "",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true
              },
              "indexByName": {
                "alertname": 0,
                "severity": 1,
                "service": 2,
                "instance": 3,
                "Value": 4
              },
              "renameByName": {
                "alertname": "Alert",
                "severity": "Severity",
                "service": "Service",
                "instance": "Instance"
              }
            }
          }
        ]
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "increase(deployment_timestamp[1m])",
          "iconColor": "blue",
          "titleFormat": "Deployment",
          "textFormat": "New deployment detected"
        },
        {
          "name": "Alerts",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "ALERTS{alertstate=\"firing\"}",
          "iconColor": "red",
          "titleFormat": "{{alertname}}",
          "textFormat": "{{summary}}"
        }
      ]
    }
  },
  "overwrite": true
}