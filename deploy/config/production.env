# Cliper Production Environment Configuration
# This file contains production-specific environment variables
# DO NOT commit sensitive values to version control

# Application Configuration
ENVIRONMENT=production
DEBUG=false
APP_NAME=Cliper
APP_VERSION=1.0.0
APP_URL=https://cliper.example.com
API_URL=https://api.cliper.example.com

# Security Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
ALLOWED_ORIGINS=https://cliper.example.com,https://www.cliper.example.com
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cliper_prod
POSTGRES_USER=cliper_user
POSTGRES_PASSWORD=your-postgres-password-change-this
DATABASE_URL=postgresql://cliper_user:your-postgres-password-change-this@postgres:5432/cliper_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-change-this
REDIS_DB=0
REDIS_URL=redis://:your-redis-password-change-this@redis:6379/0
REDIS_CACHE_TTL=3600
REDIS_SESSION_TTL=86400

# Celery Configuration
CELERY_BROKER_URL=redis://:your-redis-password-change-this@redis:6379/1
CELERY_RESULT_BACKEND=redis://:your-redis-password-change-this@redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true
CELERY_TASK_ROUTES_VIDEO_PROCESSING=video_processing
CELERY_TASK_ROUTES_NOTIFICATIONS=notifications
CELERY_TASK_ROUTES_CLEANUP=cleanup
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_BEAT_SCHEDULE_CLEANUP_TEMP_FILES=0 2 * * *
CELERY_BEAT_SCHEDULE_GENERATE_REPORTS=0 6 * * 1
CELERY_BEAT_SCHEDULE_HEALTH_CHECK=*/5 * * * *

# File Storage Configuration
UPLOAD_DIR=/opt/cliper/uploads
STATIC_DIR=/opt/cliper/static
MEDIA_DIR=/opt/cliper/media
MAX_UPLOAD_SIZE=1073741824
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,wmv,flv,webm,mkv
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,bmp,webp
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,aac,ogg,flac

# Video Processing Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
VIDEO_PROCESSING_TIMEOUT=3600
VIDEO_PROCESSING_QUALITY=medium
VIDEO_PROCESSING_FORMATS=mp4,webm
VIDEO_THUMBNAIL_COUNT=3
VIDEO_PREVIEW_DURATION=30
VIDEO_MAX_RESOLUTION=1920x1080
VIDEO_COMPRESSION_PRESET=medium
VIDEO_BITRATE_LIMIT=5000k

# AI/ML Configuration
OPENAI_API_KEY=your-openai-api-key-change-this
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60
ANTHROPIC_API_KEY=your-anthropic-api-key-change-this
ANTHROPIC_MODEL=claude-3-sonnet-20240229
GOOGLE_API_KEY=your-google-api-key-change-this
GOOGLE_MODEL=gemini-pro

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password-change-this
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=noreply@cliper.example.com
EMAIL_FROM_NAME=Cliper
DEPLOY_EMAIL=admin@cliper.example.com

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password-change-this
ALERTMANAGER_PORT=9093
ALERTMANAGER_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/cliper/app.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10
LOG_ROTATION=daily
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=cliper-logs
KIBANA_PORT=5601
LOGSTASH_PORT=5044

# Security Configuration
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' 'unsafe-eval'
CSP_STYLE_SRC='self' 'unsafe-inline'
CSP_IMG_SRC='self' data: https:
CSP_FONT_SRC='self' https:
CSP_CONNECT_SRC='self' https:
CSP_MEDIA_SRC='self' https:
CSP_OBJECT_SRC='none'
CSP_BASE_URI='self'
CSP_FORM_ACTION='self'
CSP_FRAME_ANCESTORS='none'

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_REQUESTS_PER_DAY=10000
RATE_LIMIT_BURST_SIZE=10
RATE_LIMIT_STORAGE=redis
RATE_LIMIT_KEY_FUNC=get_remote_address

# Session Configuration
SESSION_COOKIE_NAME=cliper_session
SESSION_COOKIE_DOMAIN=.cliper.example.com
SESSION_COOKIE_PATH=/
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_PERMANENT=false
SESSION_LIFETIME=86400

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/ssl/certs/cliper.crt
SSL_KEY_PATH=/etc/ssl/private/cliper.key
SSL_CA_PATH=/etc/ssl/certs/ca-certificates.crt
SSL_VERIFY_MODE=CERT_REQUIRED
SSL_CHECK_HOSTNAME=true
SSL_PROTOCOLS=TLSv1.2,TLSv1.3
SSL_CIPHERS=ECDHE+AESGCM:ECDHE+CHACHA20:DHE+AESGCM:DHE+CHACHA20:!aNULL:!MD5:!DSS

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=gzip
BACKUP_ENCRYPTION=true
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key-change-this
BACKUP_STORAGE_TYPE=s3
BACKUP_S3_BUCKET=cliper-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your-s3-access-key-change-this
BACKUP_S3_SECRET_KEY=your-s3-secret-key-change-this
BACKUP_LOCAL_PATH=/opt/cliper/backups

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_ENDPOINTS=/health,/health/ready,/health/live

# Performance Configuration
WORKER_PROCESSES=4
WORKER_THREADS=2
WORKER_CONNECTIONS=1000
WORKER_TIMEOUT=30
WORKER_KEEPALIVE=2
WORKER_MAX_REQUESTS=1000
WORKER_MAX_REQUESTS_JITTER=100
WORKER_PRELOAD_APP=true

# Cache Configuration
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=cliper:
CACHE_REDIS_HOST=redis
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=your-redis-password-change-this
CACHE_REDIS_DB=3

# API Configuration
API_RATE_LIMIT=1000/hour
API_PAGINATION_DEFAULT_LIMIT=20
API_PAGINATION_MAX_LIMIT=100
API_TIMEOUT=30
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1

# Notification Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#alerts
SLACK_USERNAME=Cliper Bot
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-change-this
TELEGRAM_CHAT_ID=your-telegram-chat-id-change-this

# External Services Configuration
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key-change-this
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key-change-this
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-change-this
AWS_ACCESS_KEY_ID=your-aws-access-key-change-this
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-change-this
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=cliper-storage
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_STORAGE_BUCKET=cliper-storage

# Development Tools (disabled in production)
DEBUG_TOOLBAR=false
PROFILER_ENABLED=false
SQL_ECHO=false
TESTING=false

# Feature Flags
FEATURE_VIDEO_TRANSCRIPTION=true
FEATURE_AI_SUMMARY=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_TOPIC_EXTRACTION=true
FEATURE_REAL_TIME_PROCESSING=true
FEATURE_BATCH_PROCESSING=true
FEATURE_WEBHOOK_NOTIFICATIONS=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_SLACK_INTEGRATION=true
FEATURE_API_RATE_LIMITING=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_EXPORT_FUNCTIONALITY=true

# Timezone Configuration
TIMEZONE=UTC
USE_TZ=true
DATE_FORMAT=%Y-%m-%d
TIME_FORMAT=%H:%M:%S
DATETIME_FORMAT=%Y-%m-%d %H:%M:%S

# Localization Configuration
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,zh,ja,ko
LOCALE_PATH=/opt/cliper/locale
TRANSLATION_BACKEND=gettext

# Content Security
CONTENT_SCAN_ENABLED=true
CONTENT_SCAN_TIMEOUT=30
CONTENT_SCAN_RETRIES=3
VIRUS_SCAN_ENABLED=true
VIRUS_SCAN_TIMEOUT=60
MALWARE_DETECTION=true
CONTENT_MODERATION=true

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_PROVIDER=google
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token-change-this
SEGMENT_WRITE_KEY=your-segment-write-key-change-this

# Compliance Configuration
GDPR_COMPLIANCE=true
CCPA_COMPLIANCE=true
DATA_RETENTION_DAYS=2555
DATA_ANONYMIZATION=true
PRIVACY_POLICY_URL=https://cliper.example.com/privacy
TERMS_OF_SERVICE_URL=https://cliper.example.com/terms
COOKIE_POLICY_URL=https://cliper.example.com/cookies

# Maintenance Configuration
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Cliper is currently under maintenance. Please try again later.
MAINTENANCE_ALLOWED_IPS=127.0.0.1,::1
MAINTENANCE_BYPASS_KEY=your-maintenance-bypass-key-change-this