# Cliper Application Configuration
# Copy this file to .env and fill in your actual values

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Application
APP_PORT=8000
WS_PORT=8001
HOST=0.0.0.0
SECRET_KEY=your-secret-key-here-change-in-production

# Database (Supabase)
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_MAX_MEMORY=512mb

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=4

# AI/LLM Services
OPENAI_API_KEY=your-openai-api-key
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# File Storage
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
MEDIA_STORAGE_PATH=./media
MAX_FILE_SIZE=2147483648  # 2GB in bytes

# Feature Flags
FEATURE_AI_SEGMENTS=true
FEATURE_THUMBNAILS=true
FEATURE_REALTIME=true
FEATURE_AUTO_OPTIMIZE=true
FEATURE_ERROR_RECOVERY=true
FEATURE_MONITORING=true
FEATURE_WEBHOOKS=false
FEATURE_ANALYTICS=false
FEATURE_GPU=false
FEATURE_DISTRIBUTED=false

# Frontend
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000

# Security
ALLOWED_HOSTS=localhost,127.0.0.1,cliper.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Monitoring (Optional)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
FLOWER_PORT=5555

# Production (when ENVIRONMENT=production)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443

